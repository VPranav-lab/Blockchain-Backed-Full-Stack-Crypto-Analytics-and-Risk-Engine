@startuml CryptoWeb-04-uc04-manage-wallet
title CryptoWeb - UC04 - Manage Simulated Wallet

!theme plain
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontSize 13
skinparam activityFontSize 13
skinparam ArrowFontSize 12
skinparam nodesep 45
skinparam ranksep 45

|Verified User|
start
:Open simulated wallet and history;
|Core Wallet Service|
:Authenticate and fetch balance/status;
|Verified User|
if (Change balance?) then (no)
  :View wallet details and history;
  stop
endif
:Select simulated deposit or withdrawal;
:Enter amount and required details;
|Core Wallet Service|
:Validate amount and transaction reference;
if (Valid request?) then (no)
  |Verified User|
  :View validation error;
  stop
endif
:Begin MySQL transaction;
:Check existing request/reference;
if (Already applied?) then (yes)
  :Return existing transaction result;
else (no)
  :Lock wallet row and verify ACTIVE status;
  if (Wallet active and funds sufficient?) then (no)
    :Rollback transaction;
    |Verified User|
    :View wallet rejection;
    stop
  endif
  :Update simulated wallet balance;
  :Insert wallet transaction and optional ledger lines;
  :Commit MySQL transaction;
endif
|Verified User|
:View updated balance or existing receipt;
stop
@enduml
