@startuml CryptoWeb-12-uc12-view-trade-audit-receipt
title CryptoWeb - UC12 - View Trade Audit Receipt

!theme plain
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontSize 13
skinparam activityFontSize 13
skinparam ArrowFontSize 12
skinparam nodesep 45
skinparam ranksep 45

|Verified User|
start
:Select a simulated trade;
:Request trade ledger receipt;
|Core Ledger Receipt Service|
:Authenticate request;
:Verify trade exists and is owned by user;
if (Owner or authorized admin?) then (no)
  |Verified User|
  :View access denied / not found;
  stop
endif
:Look up committed trade-ledger pointer;
if (Trade ledger item committed?) then (yes)
  :Build receipt and integrity proof;
  |Verified User|
  :View trade audit receipt;
else (no)
  |Verified User|
  :View receipt not yet available;
endif
stop
@enduml
