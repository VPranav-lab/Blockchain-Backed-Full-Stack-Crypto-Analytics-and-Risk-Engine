@startuml CryptoWeb-08-uc08-analyze-portfolio-risk
title CryptoWeb - UC08 - Analyze Portfolio Risk

!theme plain
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontSize 13
skinparam activityFontSize 13
skinparam ArrowFontSize 12
skinparam nodesep 45
skinparam ranksep 45

|Verified User|
start
:Open risk dashboard;
|Portfolio Risk Service|
:Authenticate user;
:Load user's FILLED trade history;
:Reconstruct current positive positions;
if (Any holdings?) then (no)
  :Produce empty or zero-value risk summary;
  |Verified User|
  :View empty portfolio state;
  stop
endif
|Portfolio Risk Service|
:Load market data and relevant news;
:Compute volatility, concentration and news risk;
:Classify overall portfolio risk;
|Verified User|
:View summary and risk drivers;
if (Request correlation or scenario?) then (yes)
  :Choose correlation, shocks or propagation;
  |Portfolio Risk Service|
  :Validate scenario parameters;
  if (Sufficient data and valid inputs?) then (yes)
    :Compute correlation or stress result;
    |Verified User|
    :View scenario analysis;
  else (no)
    |Verified User|
    :View limitation/validation message;
  endif
endif
stop
@enduml
